#pragma kernel Shade
#pragma kernel BlurH
#pragma kernel BlurV
#pragma kernel Composite

StructuredBuffer<uint> Ids;

RWTexture2D<float4> BaseOut;    // RGB base + A=1
RWTexture2D<float>  SmokeOut;   // 0..1 (generic blurred overlay mask)
RWTexture2D<float>  WaterOut;   // 0..1

Texture2D<float>    InTex;      // blur input
RWTexture2D<float>  OutTex;     // blur output

Texture2D<float4>   BaseIn;     // composite input
Texture2D<float>    SmokeBlur;
Texture2D<float>    WaterMask;
RWTexture2D<float4> Result;

int Width;
int Height;
float Time;

// Configurable IDs so this shader can be reused across projects.
// Defaults should be set from C#.
int EmptyId;   // air/sky (eg. 4)
int WaterId;   // water (eg. 2)
int SmokeId;   // optional blurred overlay (set -1 to disable)

float3 SmokeTint;     // tint for the blurred overlay
float  SmokeStrength; // overall strength
float  SmokeGamma;    // billow curve (>=1)

// ------------------------------------------------------------
// Helpers
// ------------------------------------------------------------
uint GetId(int2 p)
{
    p.x = clamp(p.x, 0, Width - 1);
    p.y = clamp(p.y, 0, Height - 1);
    return Ids[p.y * (uint)Width + (uint)p.x];
}

float Hash12(float2 p)
{
    float h = dot(p, float2(127.1, 311.7));
    return frac(sin(h) * 43758.5453123);
}

float Noise2(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);

    float a = Hash12(i);
    float b = Hash12(i + float2(1, 0));
    float c = Hash12(i + float2(0, 1));
    float d = Hash12(i + float2(1, 1));

    float2 u = f * f * (3.0 - 2.0 * f);
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// edge: boundary factor (0..1)
// bulk: interior-ness factor (0..1)
float3 ApplyVariation(uint id, int2 p, float edge, float bulk, float time)
{
    // multi-frequency noise
    float n1 = Noise2(p * 0.08);
    float n2 = Noise2(p * 0.35 + 13.7);
    float n3 = Noise2(p * 1.20 + 71.3);

    // --- SKY / AIR ---
    if ((int)id == EmptyId)
    {
        float fy = (float)p.y / max(1.0, (float)(Height - 1)); // 0 bottom → 1 top

        // light sky blues that won't fight the water
        float3 skyHorizon = float3(0.72, 0.83, 0.95);
        float3 skyZenith  = float3(0.45, 0.60, 0.82);

        float t = smoothstep(0.0, 1.0, fy);
        float3 sky = lerp(skyHorizon, skyZenith, t);

        // gentle cloud texture
        float cloud = Noise2(p * 0.015) * 0.6 + Noise2(p * 0.045 + 17.3) * 0.4;
        sky += (cloud - 0.5) * 0.04;

        // brighter near horizon
        sky *= lerp(1.08, 0.95, t);
        return saturate(sky);
    }

    // --- WATER ---
    if ((int)id == WaterId)
    {
        float3 col = float3(0.10, 0.33, 0.85);

        // darker in interior (fake depth)
        col *= (1.0 - bulk * 0.45);

        // subtle shimmer
        float shimmer = sin((p.x * 0.15 + p.y * 0.05) + time * 1.5) * 0.02;
        col += shimmer;

        // foam-ish rim
        col += edge * float3(0.10, 0.14, 0.18);

        return saturate(col);
    }

    // PixelLife defaults based on your original mapping:
    // 0 = brown (dirt)
    // 1 = green (grass)
    // 3 = white (snow/rock/whatever)
    // 4 was black in your old shader; we treat it as EmptyId by default.

    if (id == 0) // Dirt
    {
        float3 col = float3(0.588, 0.294, 0.0);

        // earthy variation
        float mott = (n1 - 0.5) * 0.18 + (n2 - 0.5) * 0.08;
        col *= (1.0 + mott);

        // small specks
        float speck = step(0.93, n3) * 0.10;
        col += speck * float3(0.08, 0.06, 0.02);

        // darker inside, brighter near edges
        col *= (1.0 - bulk * 0.22);
        col += edge * float3(0.04, 0.03, 0.01);

        return saturate(col);
    }

    if (id == 1) // Grass
    {
        float3 col = float3(0.10, 0.80, 0.18);

        // patchiness
        float patch = (n1 - 0.5) * 0.22 + (n2 - 0.5) * 0.10;
        col *= (1.0 + patch);

        // slight yellow/blue shift
        float hue = (n3 - 0.5) * 0.10;
        col += float3(hue * 0.04, hue * 0.02, -hue * 0.04);

        // darker in bulk
        col *= (1.0 - bulk * 0.15);

        // rim highlight
        col += edge * float3(0.05, 0.06, 0.03);

        return saturate(col);
    }

    if (id == 3) // White material (snow/stone/whatever)
    {
        // off-white with subtle cool tint
        float3 col = float3(0.93, 0.95, 1.00);

        float mott = (n1 - 0.5) * 0.10 + (n2 - 0.5) * 0.06;
        col *= (1.0 + mott);

        // slightly darker inside
        col *= (1.0 - bulk * 0.20);

        // edge sparkle
        col += edge * float3(0.05, 0.05, 0.06);

        return saturate(col);
    }

    // Fallback for any other IDs: render as neutral dark, but not pure black
    {
        float3 col = float3(0.12, 0.12, 0.13);
        col *= (1.0 - bulk * 0.25);
        col += edge * 0.03;
        return saturate(col);
    }
}

// ------------------------------------------------------------
// Shade pass: base + masks
// ------------------------------------------------------------
[numthreads(8, 8, 1)]
void Shade(uint3 tid : SV_DispatchThreadID)
{
    int2 p = int2(tid.xy);
    if (p.x >= Width || p.y >= Height) return;

    uint id = GetId(p);

    // Edge + bulk from neighborhood (3x3)
    int diffCount = 0;
    int sameCount = 0;

    [unroll] for (int oy = -1; oy <= 1; oy++)
    [unroll] for (int ox = -1; ox <= 1; ox++)
    {
        uint n = GetId(p + int2(ox, oy));
        diffCount += (n != id);
        sameCount += (n == id);
    }

    float edge = saturate(diffCount / 6.0);
    float bulk = saturate((sameCount - 1) / 8.0);

    float3 col = ApplyVariation(id, p, edge, bulk, Time);
    BaseOut[p] = float4(col, 1.0);

    // Generic overlay mask (blurred). If SmokeId < 0, disabled.
    SmokeOut[p] = ((SmokeId >= 0) && ((int)id == SmokeId)) ? 1.0 : 0.0;

    // Water mask
    WaterOut[p] = ((int)id == WaterId) ? 1.0 : 0.0;
}

// ------------------------------------------------------------
// Blur passes (for the overlay mask)
// ------------------------------------------------------------
[numthreads(8, 8, 1)]
void BlurH(uint3 tid : SV_DispatchThreadID)
{
    int2 p = int2(tid.xy);
    if (p.x >= Width || p.y >= Height) return;

    float w0 = 0.227027, w1 = 0.1945946, w2 = 0.1216216, w3 = 0.054054, w4 = 0.016216;

    float sum = InTex[p] * w0;
    sum += InTex[int2(max(p.x - 1, 0), p.y)] * w1;
    sum += InTex[int2(min(p.x + 1, Width - 1), p.y)] * w1;
    sum += InTex[int2(max(p.x - 2, 0), p.y)] * w2;
    sum += InTex[int2(min(p.x + 2, Width - 1), p.y)] * w2;
    sum += InTex[int2(max(p.x - 3, 0), p.y)] * w3;
    sum += InTex[int2(min(p.x + 3, Width - 1), p.y)] * w3;
    sum += InTex[int2(max(p.x - 4, 0), p.y)] * w4;
    sum += InTex[int2(min(p.x + 4, Width - 1), p.y)] * w4;

    OutTex[p] = sum;
}

[numthreads(8, 8, 1)]
void BlurV(uint3 tid : SV_DispatchThreadID)
{
    int2 p = int2(tid.xy);
    if (p.x >= Width || p.y >= Height) return;

    float w0 = 0.227027, w1 = 0.1945946, w2 = 0.1216216, w3 = 0.054054, w4 = 0.016216;

    float sum = InTex[p] * w0;
    sum += InTex[int2(p.x, max(p.y - 1, 0))] * w1;
    sum += InTex[int2(p.x, min(p.y + 1, Height - 1))] * w1;
    sum += InTex[int2(p.x, max(p.y - 2, 0))] * w2;
    sum += InTex[int2(p.x, min(p.y + 2, Height - 1))] * w2;
    sum += InTex[int2(p.x, max(p.y - 3, 0))] * w3;
    sum += InTex[int2(p.x, min(p.y + 3, Height - 1))] * w3;
    sum += InTex[int2(p.x, max(p.y - 4, 0))] * w4;
    sum += InTex[int2(p.x, min(p.y + 4, Height - 1))] * w4;

    OutTex[p] = sum;
}

// ------------------------------------------------------------
// Composite pass: base + overlay + water interaction + fog
// ------------------------------------------------------------
[numthreads(8, 8, 1)]
void Composite(uint3 tid : SV_DispatchThreadID)
{
    int2 p = int2(tid.xy);
    if (p.x >= Width || p.y >= Height) return;

    float4 baseCol = BaseIn[p];

    float overlay = saturate(SmokeBlur[p]);
    float water   = saturate(WaterMask[p]);

    // Overlay: tinted + varied + billowy
    if (SmokeId >= 0)
    {
        float n = Noise2(p * 0.06 + 19.3);
        float var = lerp(0.85, 1.15, n);

        float3 tint = SmokeTint * var;
        float a = pow(overlay, max(1.0, SmokeGamma)) * SmokeStrength;
        baseCol.rgb = lerp(baseCol.rgb, tint, saturate(a));
    }

    // Water: small lift + interaction with overlay
    if (water > 0.5)
    {
        baseCol.rgb *= 1.04;
        baseCol.rgb += float3(0.04, 0.07, 0.10) * overlay;
    }

    // Fog that blends into the sky horizon color
    float fy = (float)p.y / max(1.0, (float)(Height - 1));
    float3 fogCol = float3(0.72, 0.83, 0.95);
    float fog = smoothstep(0.25, 1.0, fy) * 0.30;
    baseCol.rgb = lerp(baseCol.rgb, fogCol, fog);

    Result[p] = float4(saturate(baseCol.rgb), 1.0);
}
